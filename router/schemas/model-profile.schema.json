{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "router-model-profile/v1",
  "title": "Deterministic router model profile V1",
  "type": "object",
  "required": [
    "router_policy_version",
    "profile_schema_version",
    "model_profile_version",
    "pricing_snapshot_date",
    "quality_snapshot_date",
    "calibration_set_version",
    "configuration_id",
    "launcher",
    "provider",
    "model",
    "effort",
    "enabled",
    "availability",
    "supports",
    "quality",
    "pricing",
    "token_consumption_observations",
    "latency_observation",
    "evidence",
    "calibration"
  ],
  "properties": {
    "router_policy_version": { "type": "string", "minLength": 1 },
    "profile_schema_version": { "const": "router-model-profile/v1" },
    "model_profile_version": { "type": "string", "minLength": 1 },
    "pricing_snapshot_date": { "type": "string", "minLength": 1 },
    "quality_snapshot_date": { "type": "string", "minLength": 1 },
    "calibration_set_version": { "type": "string", "minLength": 1 },
    "configuration_id": { "type": "string", "minLength": 1 },
    "launcher": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "effort": { "type": "string", "minLength": 1 },
    "enabled": { "type": "boolean" },
    "availability": { "type": "string", "minLength": 1 },
    "supports": {
      "type": "object",
      "required": [
        "input_modalities",
        "output_modalities",
        "languages",
        "single_turn",
        "context_window_tokens",
        "maximum_output_tokens"
      ],
      "properties": {
        "input_modalities": {
          "type": "array",
          "items": { "const": "text" },
          "minItems": 1,
          "uniqueItems": true
        },
        "output_modalities": {
          "type": "array",
          "items": { "const": "text" },
          "minItems": 1,
          "uniqueItems": true
        },
        "languages": {
          "type": "array",
          "items": { "const": "english" },
          "minItems": 1,
          "uniqueItems": true
        },
        "single_turn": { "const": true },
        "context_window_tokens": { "type": "integer", "minimum": 1 },
        "maximum_output_tokens": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": ["task_types", "domains", "complexities", "capabilities"],
      "properties": {
        "task_types": {
          "type": "object",
          "required": [
            "general",
            "coding",
            "math",
            "reasoning",
            "writing",
            "summarization",
            "extraction",
            "research_synthesis"
          ],
          "properties": {
            "general": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "coding": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "math": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "reasoning": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "writing": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "summarization": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "extraction": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "research_synthesis": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] }
          },
          "additionalProperties": false
        },
        "domains": {
          "type": "object",
          "required": [
            "general",
            "computer_science",
            "mathematics",
            "physics",
            "chemistry",
            "biology",
            "medicine",
            "engineering",
            "social_science",
            "humanities",
            "business",
            "finance",
            "law"
          ],
          "properties": {
            "general": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "computer_science": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "mathematics": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "physics": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "chemistry": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "biology": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "medicine": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "engineering": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "social_science": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "humanities": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "business": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "finance": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "law": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] }
          },
          "additionalProperties": false
        },
        "complexities": {
          "type": "object",
          "required": ["low", "medium", "high"],
          "properties": {
            "low": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "medium": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "high": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] }
          },
          "additionalProperties": false
        },
        "capabilities": {
          "type": "object",
          "required": [
            "instruction_following",
            "reasoning",
            "structured_output",
            "factual_reliability",
            "source_grounded_synthesis",
            "long_context"
          ],
          "properties": {
            "instruction_following": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "reasoning": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "structured_output": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "factual_reliability": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "source_grounded_synthesis": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] },
            "long_context": { "enum": ["unsupported", "unknown", "standard", "strong", "frontier"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pricing": {
      "type": "object",
      "required": [
        "currency",
        "rate_unit",
        "input_usd_per_million_tokens",
        "output_usd_per_million_tokens",
        "effective_from",
        "effective_through"
      ],
      "properties": {
        "currency": { "const": "USD" },
        "rate_unit": { "const": "per_million_tokens" },
        "input_usd_per_million_tokens": { "type": "number", "minimum": 0 },
        "output_usd_per_million_tokens": { "type": "number", "minimum": 0 },
        "effective_from": { "type": "string", "minLength": 1 },
        "effective_through": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "token_consumption_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "model",
          "effort",
          "request_profile_group",
          "estimated_input_tokens",
          "estimated_visible_output_tokens",
          "estimated_reasoning_tokens",
          "observed_on"
        ],
        "properties": {
          "model": { "type": "string", "minLength": 1 },
          "effort": { "type": "string", "minLength": 1 },
          "request_profile_group": { "type": "string", "minLength": 1 },
          "estimated_input_tokens": { "type": "integer", "minimum": 0 },
          "estimated_visible_output_tokens": { "type": "integer", "minimum": 0 },
          "estimated_reasoning_tokens": { "type": "integer", "minimum": 0 },
          "observed_on": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "latency_observation": {
      "type": "object",
      "required": ["metric", "milliseconds", "sample_count", "observed_on"],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "milliseconds": { "type": "number", "minimum": 0 },
        "sample_count": { "type": "integer", "minimum": 1 },
        "observed_on": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["provider", "artificial_analysis"],
      "properties": {
        "provider": {
          "type": "object",
          "required": ["source_url", "retrieved_on", "fixture_only"],
          "properties": {
            "source_url": { "type": "string", "minLength": 1 },
            "retrieved_on": { "type": "string", "minLength": 1 },
            "fixture_only": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "artificial_analysis": {
          "type": "object",
          "required": [
            "source_url",
            "retrieved_on",
            "exact_model_match",
            "exact_effort_match",
            "benchmark_slice",
            "fixture_only"
          ],
          "properties": {
            "source_url": { "type": "string", "minLength": 1 },
            "retrieved_on": { "type": "string", "minLength": 1 },
            "exact_model_match": { "type": "boolean" },
            "exact_effort_match": { "type": "boolean" },
            "benchmark_slice": { "type": "string", "minLength": 1 },
            "fixture_only": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "calibration": {
      "type": "object",
      "required": ["status", "version"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
