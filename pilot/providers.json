{
  "schema_version": 1,
  "contract_path": "pilot/shared/experiment_contract.md",
  "response_schema_path": "pilot/shared/response_schema.json",
  "model_matrix_path": "pilot/model_matrix.json",
  "default_task_path": "pilot/tasks/001_smoke_test.md",
  "results_path": "pilot/results/test-run.jsonl",
  "providers": [
    {
      "id": "openai_codex",
      "provider": "openai",
      "agent": "codex",
      "instruction_file": "pilot/providers/openai/AGENTS.md",
      "access_mode": "chatgpt_subscription",
      "model": "gpt-5.6-sol",
      "requested_effort": "medium",
      "model_verification": "pending_in_user_cli",
      "launcher": {
        "command": "codex",
        "mode": "exec",
        "arguments": ["--ephemeral", "--json", "-s", "read-only", "--model", "gpt-5.6-sol"],
        "requires_skip_git_repo_check_until_repo_setup": true
      },
      "auth_verified": true,
      "smoke_test_verified": true,
      "verified_by": "user_terminal",
      "enabled": true
    },
    {
      "id": "anthropic_claude_code",
      "provider": "anthropic",
      "agent": "claude-code",
      "instruction_file": "pilot/providers/anthropic/CLAUDE.md",
      "access_mode": "claude_subscription",
      "model": "claude-sonnet-5",
      "requested_effort": "medium",
      "model_verification": "verified",
      "launcher": {
        "command": "claude",
        "mode": "print",
        "arguments": [
          "--model",
          "claude-sonnet-5",
          "--effort",
          "medium",
          "--output-format",
          "json",
          "--max-turns",
          "1"
        ]
      },
      "auth_verified": true,
      "smoke_test_verified": true,
      "verified_by": "user_terminal",
      "enabled": true
    },
    {
      "id": "google_agent",
      "provider": "google",
      "agent": "agy",
      "instruction_file": "pilot/providers/google/GEMINI.md",
      "access_mode": "google_subscription",
      "model": "gemini-3.7-flash-medium",
      "available_models": [
        "gemini-3.7-flash-high",
        "gemini-3.7-flash-medium",
        "gemini-3.7-flash-low",
        "gemini-3.6-flash-high",
        "gemini-3.6-flash-medium",
        "gemini-3.6-flash-low",
        "gemini-3.5-flash-high",
        "gemini-3.5-flash-medium",
        "gemini-3.5-flash-low",
        "gemini-3.1-pro-high",
        "gemini-3.1-pro-low"
      ],
      "requested_effort": "medium",
      "model_verification": "verified_from_user_terminal",
      "launcher": {
        "command": "agy",
        "mode": "print",
        "arguments": [
          "--print",
          "--output-format",
          "json",
          "--effort",
          "medium",
          "--print-timeout",
          "2m"
        ],
        "model_argument": "--model",
        "requires_interactive_login": true
      },
      "auth_verified": true,
      "smoke_test_verified": true,
      "verified_by": "user_terminal",
      "enabled": true
    }
  ]
